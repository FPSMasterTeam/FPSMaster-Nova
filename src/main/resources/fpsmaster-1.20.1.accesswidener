accessWidener	v1	named

# 1.20.1 access widener. The 1.21.11 widener opens the 1.21.5+ RenderPipeline$Builder, which does
# not exist here. Entries are added as the 1.20.1 render bridge needs them.

# Sprint reads the bound sprint key directly; on 1.21.5+ this is done via the IKeyMapping mixin
# accessor, which is excluded from the minimal 1.20.1 build.
accessible field net/minecraft/client/KeyMapping key Lcom/mojang/blaze3d/platform/InputConstants$Key;

# LevelTag health nametag: the 1.20.1 EntityRenderer.renderNameTag is protected; the BetterChat-style
# redirect calls it on the instance, so it must be accessible.
accessible method net/minecraft/client/renderer/entity/EntityRenderer renderNameTag (Lnet/minecraft/world/entity/Entity;Lnet/minecraft/network/chat/Component;Lcom/mojang/blaze3d/vertex/PoseStack;Lnet/minecraft/client/renderer/MultiBufferSource;I)V

# 1.19.2 has no Minecraft.getFps(); the FPS HUD reads the private static `fps` field directly.
accessible field net/minecraft/client/Minecraft fps I
